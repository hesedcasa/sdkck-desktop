{
  "name": "sdkck-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for sdkck: set up, browse, and run sdkck plugin commands",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p ui && vite build",
    "typecheck": "tsc --noEmit -p ui",
    "test": "node --experimental-strip-types --no-warnings --test ui/src/lib/*.test.ts",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
